{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kaleidoscope_harvest.juicer_visual": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "juice_orange": "v.colour == 1 && v.shown > 0.02"
        },
        {
          "juice_grape": "v.colour == 2 && v.shown > 0.02"
        },
        {
          "juice_mango": "v.colour == 3 && v.shown > 0.02"
        },
        {
          "juice_milk": "v.colour == 4 && v.shown > 0.02"
        }
      ]
    }
  }
}
