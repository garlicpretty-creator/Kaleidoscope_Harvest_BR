        }
      },
      {
        "condition": "q.block_state('kaleidoscope_harvest:blossom') == true && q.block_state('kaleidoscope_harvest:off_climate') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "kh_mandarin_leaves_blossom_grey",
