{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "kaleidoscope_harvest:cinnamon_tea",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "kaleidoscope_cookery:cup_count": {
          "values": {
            "min": 1,
            "max": 4
          }
        },
        "kaleidoscope_cookery:tea_count": {
          "values": {
            "min": 1,
            "max": 4
          }
        }
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "minecraft:display_name": "tile.kaleidoscope_harvest:cinnamon_tea.name",
      "minecraft:geometry": {
        "identifier": "geometry.kaleidoscope_harvest.food_teacup",
        "bone_visibility": {
          "cup_1": "q.block_state('kaleidoscope_cookery:cup_count') >= 1",
          "tea_1": "q.block_state('kaleidoscope_cookery:cup_count') >= 1 && q.block_state('kaleidoscope_cookery:tea_count') >= 1",
          "cup_2": "q.block_state('kaleidoscope_cookery:cup_count') >= 2",
          "tea_2": "q.block_state('kaleidoscope_cookery:cup_count') >= 2 && q.block_state('kaleidoscope_cookery:tea_count') >= 2",
          "cup_3": "q.block_state('kaleidoscope_cookery:cup_count') >= 3",
          "tea_3": "q.block_state('kaleidoscope_cookery:cup_count') >= 3 && q.block_state('kaleidoscope_cookery:tea_count') >= 3",
          "cup_4": "q.block_state('kaleidoscope_cookery:cup_count') >= 4",
          "tea_4": "q.block_state('kaleidoscope_cookery:cup_count') >= 4 && q.block_state('kaleidoscope_cookery:tea_count') >= 4"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "kh_food_cinnamon_tea",
          "render_method": "alpha_test"
        }
      },
      "minecraft:selection_box": {
        "origin": [
          -6,
          0,
          -6
        ],
        "size": [
          12,
          3,
          12
        ]
      },
      "minecraft:collision_box": false,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.3
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1
      },
      "minecraft:light_dampening": 0,
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": [
              "up"
            ]
          }
        ]
      },
      "kaleidoscope_cookery:placeable_food_placement_guard": {},
      "minecraft:loot": "loot_tables/kaleidoscope_harvest/placed_nothing.json",
      "kaleidoscope_cookery:cup_stack": {
        "filled": true,
        "item": "kaleidoscope_harvest:cinnamon_tea",
        "empty_item": "kaleidoscope_cookery:empty_cup",
        "max_count": 4
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              270,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      }
    ]
  }
}
